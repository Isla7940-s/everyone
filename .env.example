# ===== LLM（OpenAI 兼容三件套，PRD D3）=====
OPENAI_BASE_URL=https://your-gateway.example.com/v1
OPENAI_API_KEY=sk-xxx
# 主模型（分身执行、评审、日报等长文任务）
MODEL=kimi-k3
# 快模型（意图识别等高频短任务；不填则用 MODEL）
MODEL_FAST=deepseek-v4-flash

# ===== 飞书（凭证由 lark-cli 自管，见 LARK-CLI.md；此处只有非密项，PRD D17）=====
LARK_CLI_BIN=lark-cli
# demo 群 chat_id（oc_ 开头；`pnpm dev` 首次启动会引导创建/选择）
DEMO_CHAT_ID=
# 日报时间（HH:mm，本地时区）
DAILY_DIGEST_TIME=18:30

# ===== 运行模式 =====
# lark = 真实飞书；mock = 内置模拟群聊（开发/演示用，走同一套业务代码）
CHAT_ADAPTER=lark
# 演示模式：允许预热与缓存产物重放（不伪造结果，只缩短等待）
DEMO_MODE=0
# 管理后台 & mock 群聊端口
ADMIN_PORT=8901
# server API 端口
SERVER_PORT=8902

# ===== 记忆引擎（TencentDB Agent Memory，PRD D18）=====
# 不可用时自动降级为 memory.md 直读 + SQLite LIKE（FR-F6）
MEMORY_GATEWAY_PORT=8420
# Gateway 鉴权 key（docker 容器自动生成，README「记忆引擎」一节有获取命令）
TDAI_GATEWAY_API_KEY=

# ===== 执行引擎 =====
# opencode 二进制路径（默认 PATH 里的 opencode）
OPENCODE_BIN=opencode
# 单次执行超时（秒）
OPENCODE_TIMEOUT_SEC=600

# ===== 跨端协同（跨端协同.md）=====
# 云端 Agent 远程求助 MCP（request_remote_help / wait_help_result）单次阻塞等待秒数
COLLAB_HELP_TIMEOUT_SEC=600

# ===== 数据目录（可选）=====
# 默认 data/；压测与多实例隔离时覆盖（如 DATA_DIR=data-stress）
# DATA_DIR=data
